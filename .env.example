# -----------------------------------------------------------------
# Tout est OPTIONNEL. Sans rien configurer, les 9 skills fonctionnent :
# elles écrivent la légende, le hook, les hashtags, le plan du carrousel
# et de la semaine. Tu publies toi-même dans l'app Instagram.
#
# Une seule variable existe, pour la skill ig-audience-insights (et le
# repli de ig-hook-extractor) : un token Apify pour lire les données
# publiques d'un hashtag ou d'un profil. Sans token, tu colles les posts
# et les chiffres à la main et la skill fait la même analyse.
#
# Inscription : https://console.apify.com/sign-up
# Token :       https://console.apify.com/settings/integrations
# Vérifie le plan et les coûts sur leur site avant de brancher.
#
# Un token est une clé : garde-le sur ton ordinateur, ne le colle jamais
# dans une conversation partagée.
# -----------------------------------------------------------------
APIFY_TOKEN=apify_api_ton_token_ici
